#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> a(n);
    for(int &x : a) cin >> x;

    int mn = a[0], mx = a[0];

    for(int x : a) {
        mn = min(mn, x);
        mx = max(mx, x);
    }

    cout << "Min = " << mn << endl;
    cout << "Max = " << mx << endl;
}
