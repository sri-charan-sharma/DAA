#include <bits/stdc++.h>
using namespace std;

struct Job {
    char id;
    int deadline;
    int profit;
};

int main() {
    int n;
    cin >> n;

    vector<Job> jobs(n);

    for(auto &j : jobs)
        cin >> j.id >> j.deadline >> j.profit;

    sort(jobs.begin(), jobs.end(),
         [](Job a, Job b) {
             return a.profit > b.profit;
         });

    int maxDeadline = 0;

    for(auto j : jobs)
        maxDeadline = max(maxDeadline, j.deadline);

    vector<char> slot(maxDeadline + 1, '-');

    int totalProfit = 0;

    for(auto j : jobs) {

        for(int d = j.deadline; d >= 1; d--) {

            if(slot[d] == '-') {
                slot[d] = j.id;
                totalProfit += j.profit;
                break;
            }
        }
    }

    cout << "Jobs: ";

    for(int i = 1; i <= maxDeadline; i++)
        if(slot[i] != '-')
            cout << slot[i] << " ";

    cout << "\nProfit = " << totalProfit;
}
